    {
      "text": "import org.apache.spark.sql.types._\r\nimport org.apache.spark.sql.functions._\r\n\r\nval dateColsNames = dfClimaClean\r\n    .schema\r\n    .fields\r\n    .filter {\r\n        case StructField(_, TimestampType | DateType, _, _) => true\r\n        case _ => false\r\n    }.map(_.name)\r\n\r\n//  Ejemplo de cálculo de estadísticas comunes\r\nval statsExprs = dateColsNames\r\n    .flatMap { colName =>\r\n        Seq(\r\n            count(col(colName)).alias(s\"${colName}_count\"),\r\n            min(col(colName)).alias(s\"${colName}_min\"),\r\n            max(col(colName)).alias(s\"${colName}_max\"),\r\n            countDistinct(col(colName)).alias(s\"${colName}_countDistinct\")\r\n        )\r\n\r\n    }\r\nval dfStatsDateCols = dfClimaClean\r\n    .select(statsExprs: _*)\r\ndfStatsDateCols.show()",
      "user": "anonymous",
      "dateUpdated": "2025-07-10T01:49:30+0000",
      "progress": 0,
      "config": {
